# Resend + form email (copy to `.dev.vars` for local Cloudflare / `astro dev`)
#
# Cloudflare adapter reads secrets from `.dev.vars` at runtime.
# You can also keep a `.env` copy for editors / tooling — same keys.

# Required to send mail
RESEND_API_KEY=re_xxxxxxxx

# Optional overrides (defaults live in src/config/site.ts)
# CONTACT_TO_EMAIL=rachelinflower@gmail.com
# Until your domain is verified in Resend, keep the test sender:
# CONTACT_FROM_EMAIL=Soul Flower Somatics <onboarding@resend.dev>
# After DNS verify on soulflowersomatics.com:
# CONTACT_FROM_EMAIL=Soul Flower Somatics <hello@soulflowersomatics.com>

# Decap CMS GitHub OAuth (production /admin login)
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
# GITHUB_REPO_PRIVATE=1
