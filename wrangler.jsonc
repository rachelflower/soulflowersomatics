{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-07-30",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "soulflowersomatics",
	// Static HTML/assets land in dist/client (Astro Cloudflare adapter).
	// Cloudflare Pages dashboard: Build output directory = dist/client
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist/client",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	}
}
