---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatEventDate, toEventItem } from '../../lib/content/events';

export async function getStaticPaths() {
	const entries = await getCollection('events');
	return entries.map((entry) => ({
		params: { slug: entry.id },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const event = toEventItem(entry);
const { Content } = await render(entry);
const registerLabel = event.registrationLabel ?? 'Reserve your spot';
const hasBody = Boolean(entry.body?.trim());
---

<BaseLayout
	title={event.title}
	description={event.summary ?? `${event.title} — ${formatEventDate(event.date)}`}
>
	<section class="section">
		<div class="wrap wrap--narrow">
			<p class="eyebrow">
				<a href="/gatherings">Gatherings</a>
			</p>
			<h1>{event.title}</h1>
			<p class="meta">
				{formatEventDate(event.date)}
				{event.time ? ` · ${event.time}` : ''}
				{event.venue ? ` · ${event.venue}` : ''}
			</p>
			{
				event.image && (
					<img class="poster" src={event.image} alt="" width="900" height="600" loading="eager" />
				)
			}
			{event.summary && <p class="summary">{event.summary}</p>}
			{hasBody && (
				<div class="body">
					<Content />
				</div>
			)}

			<div class="register">
				{
					event.registrationUrl ? (
						<>
							<h2>Registration</h2>
							<p class="lede">Reserve your spot through the secure registration form.</p>
							<a
								class="btn btn--primary"
								href={event.registrationUrl}
								target="_blank"
								rel="noopener noreferrer"
							>
								{registerLabel}
							</a>
						</>
					) : (
						<>
							<h2>Reserve a spot</h2>
							<p class="lede">
								Registration for this gathering is by text or email. Reach out and I’ll confirm
								details with you.
							</p>
							<p class="contact-line">
								<a href="sms:+14158272623">Text 415-827-2623</a>
								{' · '}
								<a href="/contact">Contact</a>
							</p>
						</>
					)
				}
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	.eyebrow a {
		text-decoration: none;
	}

	h1 {
		margin: 0 0 0.75rem;
	}

	.meta {
		color: var(--color-ink-soft);
		margin: 0 0 1.5rem;
	}

	.poster {
		width: 100%;
		aspect-ratio: 3 / 2;
		object-fit: cover;
		margin-bottom: 1.5rem;
	}

	.summary {
		font-size: 1.1rem;
		color: var(--color-ink-soft);
		margin-bottom: 1.25rem;
	}

	.body {
		color: var(--color-ink-soft);
		line-height: 1.65;
		margin-bottom: 2rem;
	}

	.body :global(p) {
		margin: 0 0 1rem;
	}

	.body :global(ul) {
		margin: 0 0 1rem;
		padding-left: 1.25rem;
	}

	.register {
		display: grid;
		gap: 1rem;
		padding-top: var(--space-lg);
		border-top: 1px solid rgba(47, 74, 64, 0.12);
		justify-items: start;
	}

	.register h2 {
		margin: 0;
	}

	.lede {
		margin: 0;
		color: var(--color-ink-soft);
	}

	.contact-line {
		margin: 0;
	}

	.contact-line a {
		font-weight: 600;
	}
</style>
