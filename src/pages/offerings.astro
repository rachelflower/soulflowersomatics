---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getOfferings } from '../lib/content/offerings';

const offerings = await getOfferings();
---

<BaseLayout
	title="Offerings"
	description="Somatic coaching, Sohum Breathing, sound healing, resonant branding, and psychedelic somatic integration."
>
	<section class="page-hero section section--tight">
		<div class="wrap wrap--narrow reveal">
			<p class="eyebrow">Offerings</p>
			<h1>Come home to yourself</h1>
			<p class="lede">
				Every offering is an invitation to come home to yourself. Whether through the breath, the
				body, or the resonance of your soul’s voice, each path opens a door into greater aliveness.
			</p>
		</div>
	</section>

	<section class="section offerings">
		<div class="wrap">
			{
				offerings.map((offering, i) => (
					<article
						id={offering.slug}
						class:list={['offering', 'reveal', i % 2 === 1 ? 'reveal-delay-1' : undefined]}
					>
						<span class="offering__index">{String(i + 1).padStart(2, '0')}</span>
						<div>
							<h2>{offering.title}</h2>
							<p>{offering.body}</p>
						</div>
					</article>
				))
			}

			<div class="book reveal">
				<a class="btn btn--primary" href="/contact">Get in touch to book a session →</a>
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	.page-hero h1 {
		margin: 0 0 1rem;
	}

	.offerings {
		padding-top: var(--space-md);
	}

	.offering {
		display: grid;
		gap: 1rem;
		padding-block: var(--space-lg);
		border-top: 1px solid rgba(18, 24, 22, 0.12);
		max-width: 46rem;
	}

	@media (min-width: 640px) {
		.offering {
			grid-template-columns: 3.5rem 1fr;
			gap: 1.5rem;
		}
	}

	.offering:last-of-type {
		border-bottom: 1px solid rgba(18, 24, 22, 0.12);
	}

	.offering__index {
		font-family: var(--font-display);
		font-style: italic;
		font-size: 1.15rem;
		color: var(--color-sage);
		padding-top: 0.35rem;
	}

	.offering h2 {
		margin: 0 0 0.85rem;
	}

	.offering p {
		margin: 0;
		color: var(--color-ink-soft);
		font-size: 1.05rem;
	}

	.book {
		margin-top: var(--space-xl);
	}
</style>
