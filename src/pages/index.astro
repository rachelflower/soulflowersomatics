---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config/site';
import { getHomeOfferings } from '../lib/content/offerings';
import { formatEventDate, getEvents, upcomingFrom } from '../lib/content/events';

const homeOfferings = await getHomeOfferings();
const featured = upcomingFrom(await getEvents(), new Date(), 3);
---

<BaseLayout
	transparentNav
	title={site.name}
	description="Something brought you here. Restoration, resonance, and deep remembering through breath, sound, and somatic presence."
>
	<section class="hero" aria-label="Welcome">
		<video
			class="hero__video"
			autoplay
			muted
			loop
			playsinline
			poster="/videos/hero-poster.jpg"
			aria-hidden="true"
		>
			<source src="/videos/SoulFlowerSomatics_Banner1.mp4" type="video/mp4" />
		</video>
		<div class="hero__veil" aria-hidden="true"></div>
		<div class="hero__content">
			<img
				class="hero__logo"
				src="/images/SoulFlowerSomatics_HorizontalLogoBlack.webp"
				alt="Soul Flower Somatics"
				width="480"
				height="100"
			/>
			<h1 class="hero__headline">
				<span>Remember why</span>
				<span>you came here.</span>
			</h1>
			<p class="hero__support">Restoration, resonance, and deep remembering.</p>
			<a class="btn btn--ghost" href="/gatherings">Begin your journey →</a>
		</div>
	</section>

	<section class="section intro">
		<div class="wrap wrap--narrow reveal">
			<h2 class="display-title">
				Restoration, Resonance,<br />&amp; Deep Remembering
			</h2>
			<div class="intro__body">
				<p>Something brought you here.</p>
				<p>Maybe it was a longing you couldn’t name.</p>
				<p>Maybe it was exhaustion with who you’ve been pretending to be.</p>
				<p>
					Maybe it was the quiet knowing that your body holds something your mind hasn’t caught up
					to yet.
				</p>
				<p>
					Whatever it was — you were right to follow it. What you’re moving toward has a name. I
					call it the <em>Flower State</em> — your body’s natural condition of aliveness, already
					present, waiting to be remembered.
				</p>
			</div>
		</div>
	</section>

	<figure class="bleed reveal" aria-hidden="true">
		<img
			src="/images/unsplash-image-Gjcszn2dKFw.webp"
			alt=""
			width="1600"
			height="900"
			loading="lazy"
		/>
	</figure>

	<section class="section offerings-teaser section--wash">
		<div class="wrap">
			<div class="section-head reveal">
				<p class="eyebrow">Offerings</p>
				<h2>Ways to arrive</h2>
			</div>
			<ul class="offering-list">
				{
					homeOfferings.map((offering, i) => (
						<li class:list={['reveal', `reveal-delay-${Math.min(i, 2)}`]}>
							<a href={`/offerings#${offering.slug}`}>
								<span class="offering-list__index">{String(i + 1).padStart(2, '0')}</span>
								<span>
									<h3>{offering.title}</h3>
									<p>{offering.teaser}</p>
								</span>
							</a>
						</li>
					))
				}
			</ul>
			<p class="section-cta reveal">
				<a class="btn btn--outline" href="/offerings">Learn more →</a>
			</p>
		</div>
	</section>

	<figure class="bleed reveal" aria-hidden="true">
		<img src="/images/Flowstate.webp" alt="" width="1600" height="900" loading="lazy" />
	</figure>

	<section class="section gatherings-teaser">
		<div class="wrap">
			<div class="section-head section-head--center reveal">
				<p class="eyebrow">Upcoming gatherings</p>
				<h2>Where souls meet to remember together…</h2>
				<p class="lede italic-accent">
					Step outside time. Circle with kindred spirits. Breathe, move, sound, and awaken in
					community.
				</p>
			</div>
			{
				featured.length > 0 ? (
					<ul class="event-list">
						{featured.map((event, i) => (
							<li class:list={['event-card', 'reveal', `reveal-delay-${Math.min(i, 2)}`]}>
								{event.image && (
									<a href={`/gatherings/${event.slug}`} class="event-card__media">
										<img src={event.image} alt="" loading="lazy" />
									</a>
								)}
								<div class="event-card__body">
									<p class="event-card__date">{formatEventDate(event.date)}</p>
									<h3>
										<a href={`/gatherings/${event.slug}`}>{event.title}</a>
									</h3>
									<p class="event-card__meta">
										{[event.time, event.venue].filter(Boolean).join(' · ')}
									</p>
									{event.summary && <p>{event.summary}</p>}
									<a class="event-card__link" href={`/gatherings/${event.slug}`}>
										View gathering →
									</a>
								</div>
							</li>
						))}
					</ul>
				) : (
					<p class="reveal">New gatherings are being planned. Join the list to hear first.</p>
				)
			}
			<p class="section-cta section-cta--center reveal">
				<a class="btn btn--primary" href="/gatherings">See full calendar</a>
			</p>
		</div>
	</section>

	<section class="section newsletter section--ink" id="newsletter">
		<div class="wrap wrap--narrow reveal">
			<h2>Stay connected</h2>
			<p class="lede">Sign up to receive event notifications and updates.</p>
			<p class="newsletter__note">
				Newsletter signup is coming next — for now,
				<a href="/contact">reach out</a> and I’ll keep you in the loop.
			</p>
		</div>
	</section>
</BaseLayout>

<style>
	.hero {
		position: relative;
		min-height: 100svh;
		display: grid;
		place-items: center;
		text-align: center;
		color: var(--color-white);
		overflow: hidden;
	}

	.hero__video {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		z-index: 0;
	}

	.hero__veil {
		position: absolute;
		inset: 0;
		z-index: 1;
		background:
			radial-gradient(ellipse 70% 55% at 50% 45%, rgba(10, 16, 14, 0.15), transparent 70%),
			linear-gradient(180deg, rgba(10, 16, 14, 0.45) 0%, rgba(10, 16, 14, 0.2) 35%, rgba(10, 16, 14, 0.55) 100%);
	}

	.hero__content {
		position: relative;
		z-index: 2;
		width: min(100% - 2.5rem, 42rem);
		padding-block: calc(var(--nav-height) + 3rem) 4rem;
		display: grid;
		justify-items: center;
		gap: 1.25rem;
		animation: hero-rise 1.2s var(--ease-out) both;
	}

	.hero__logo {
		width: min(100%, 18rem);
		height: auto;
		filter: brightness(0) invert(1);
		margin-bottom: 0.5rem;
	}

	.hero__headline {
		color: var(--color-white);
		margin: 0;
		font-size: clamp(2.75rem, 8vw, 5rem);
		line-height: 1.05;
		font-weight: 400;
	}

	.hero__headline span {
		display: block;
	}

	.hero__support {
		margin: 0;
		max-width: 26rem;
		font-size: 1.05rem;
		line-height: 1.55;
		color: rgba(255, 255, 255, 0.86);
	}

	.intro {
		text-align: center;
	}

	.intro__body {
		text-align: left;
		margin-inline: auto;
	}

	.intro__body p {
		font-size: clamp(1.1rem, 2vw, 1.3rem);
		line-height: 1.75;
		color: var(--color-ink-soft);
	}

	.intro__body em {
		font-family: var(--font-display);
		font-style: italic;
		color: var(--color-sage-deep);
	}

	.section-head {
		margin-bottom: var(--space-lg);
		max-width: 40rem;
	}

	.section-head h2 {
		margin: 0 0 0.75rem;
	}

	.section-head--center {
		margin-inline: auto;
		text-align: center;
	}

	.section-head--center .lede {
		margin-inline: auto;
	}

	.section-cta {
		margin-top: var(--space-lg);
	}

	.section-cta--center {
		text-align: center;
	}

	.offering-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0;
		border-top: 1px solid rgba(18, 24, 22, 0.12);
	}

	.offering-list li {
		border-bottom: 1px solid rgba(18, 24, 22, 0.12);
	}

	.offering-list a {
		display: grid;
		grid-template-columns: 3rem 1fr;
		gap: 1rem;
		align-items: start;
		padding-block: 1.6rem;
		text-decoration: none;
		color: inherit;
	}

	.offering-list__index {
		font-family: var(--font-display);
		font-style: italic;
		color: var(--color-sage);
		padding-top: 0.2rem;
	}

	.offering-list a:hover h3 {
		color: var(--color-sage-deep);
	}

	.offering-list h3 {
		margin: 0 0 0.35rem;
	}

	.offering-list p {
		margin: 0;
		color: var(--color-ink-soft);
		max-width: 36rem;
	}

	.event-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: var(--space-xl);
	}

	.event-card {
		display: grid;
		gap: 1.5rem;
		align-items: center;
	}

	@media (min-width: 800px) {
		.event-card {
			grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
			gap: 2.5rem;
		}

		.event-card:nth-child(even) .event-card__media {
			order: 2;
		}
	}

	.event-card__media {
		display: block;
		overflow: hidden;
	}

	.event-card img {
		width: 100%;
		height: auto;
		transition: transform 0.8s var(--ease-out);
	}

	@media (max-width: 799px) {
		.event-list {
			gap: var(--space-lg);
		}

		.event-card {
			gap: 1rem;
		}

		.event-card img {
			width: auto;
			max-width: 100%;
			max-height: 14rem;
			height: auto;
			margin-inline: auto;
		}
	}

	.event-card__media:hover img {
		transform: scale(1.03);
	}

	.event-card h3 {
		margin: 0.35rem 0 0.55rem;
	}

	.event-card h3 a {
		text-decoration: none;
		color: inherit;
	}

	.event-card h3 a:hover {
		color: var(--color-sage-deep);
	}

	.event-card__date {
		margin: 0;
		font-size: 0.78rem;
		font-weight: 600;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--color-sage-deep);
	}

	.event-card__meta {
		margin: 0 0 0.85rem;
		color: var(--color-ink-soft);
		font-size: 0.95rem;
	}

	.event-card__link {
		font-weight: 600;
		text-decoration: none;
	}

	.newsletter {
		text-align: center;
	}

	.newsletter h2 {
		margin: 0 0 0.75rem;
	}

	.newsletter .lede {
		margin-inline: auto;
		color: rgba(255, 255, 255, 0.8);
	}

	.newsletter__note {
		margin-top: 1.25rem;
		font-size: 0.95rem;
		color: rgba(255, 255, 255, 0.7);
	}

	.newsletter__note a {
		color: var(--color-sage);
	}

	@keyframes hero-rise {
		from {
			opacity: 0;
			transform: translateY(1.75rem);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero__content {
			animation: none;
		}

		.event-card img {
			transition: none;
		}
	}
</style>
